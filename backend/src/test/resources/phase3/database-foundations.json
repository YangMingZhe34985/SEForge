{
  "course": "database-foundations",
  "documents": [
    {
      "source": "atomicity.pdf",
      "text": "Atomicity ensures a transaction either commits all its changes or leaves none committed."
    },
    {
      "source": "consistency.ppt",
      "text": "Consistency preserves declared database constraints across committed transactions."
    },
    {
      "source": "isolation.pptx",
      "text": "Isolation controls how concurrent transactions observe one another's changes."
    },
    {
      "source": "durability.docx",
      "text": "Durability means acknowledged committed changes survive a subsequent process restart."
    },
    {
      "source": "primarykey.md",
      "text": "A primarykey uniquely identifies a row and cannot contain null values."
    },
    {
      "source": "foreignkey.txt",
      "text": "A foreignkey enforces that a referenced row exists, subject to its declared delete policy."
    },
    {
      "source": "normalization.pdf",
      "text": "Normalization decomposes relations to reduce redundancy and update anomalies."
    },
    {
      "source": "indexing.ppt",
      "text": "Indexing adds lookup structures to speed selected queries at storage and write cost."
    },
    {
      "source": "deadlock.pptx",
      "text": "A deadlock is a cycle of transactions waiting for locks held by one another."
    },
    {
      "source": "optimistic.docx",
      "text": "Optimistic concurrency compares a version before committing and rejects stale updates."
    }
  ],
