# Browser requests use the same-origin API by default.
VITE_API_BASE_URL=/api/v1

# Vite development proxy target. `npm run dev` enables it by default via the committed
# .env.development; per-machine overrides go in .env.development.local (empty value disables).
# Not used by production builds, where a reverse proxy serves same-origin /api/v1.
SEFORGE_API_PROXY=http://127.0.0.1:8080
