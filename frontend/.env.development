# Loaded automatically by `npm run dev` (Vite mode=development) — do not delete.
# Bridges the dev server to the local backend: cd backend && ./mvnw spring-boot:run
# Per-machine overrides (e.g. the Docker stack at http://127.0.0.1:8081) belong in
# .env.development.local — it is gitignored and takes precedence over this file.
# NOTE: .env.local does NOT override .env.development (Vite loads mode files later).
# Set SEFORGE_API_PROXY= (empty) in .env.development.local to disable the proxy.
SEFORGE_API_PROXY=http://127.0.0.1:8080

# Browser API base defaults to same-origin /api/v1 in src/api/client.ts.
# VITE_API_BASE_URL=/api/v1
