# ==========================================
# SEForge monorepo .gitignore
# ==========================================

# ---------- Java / Spring Boot ----------
target/
bin/
build/
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
*.war
*.ear
*.nar
!**/maven-wrapper.jar
hs_err_pid*
replay_pid*
.mtj.tmp/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ---------- Node / Vue / Vite ----------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
/cypress/videos/
/cypress/screenshots/

# ---------- IDE ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- Environment / secrets ----------
.env
.env.local
.env.*.local
*.local
/docs/local/

# Claude Code local settings
.claude/

# ---------- Runtime data & large model files (backend) ----------
# 以下目录为运行时数据 / 大体积模型文件，仅保留在本地磁盘，不进入版本库
backend/nlp-models/
backend/models/
backend/temp/
backend/hanlp/
backend/docker/volumes/
backend/mysql-connector-java-5.1.49/

# ---------- Archives ----------
*.zip
*.tar.gz
*.rar

# ---------- OS ----------
.DS_Store
Thumbs.db
