# SEForge deployment environment
# Copy to .env and replace every "change-me" value before starting the stack.
# Never commit .env or real credentials.

# Image and HTTP entry point. Replace `local` with an immutable release or Git SHA tag in production.
SEFORGE_IMAGE_TAG=local
# Bind locally by default. Put a TLS reverse proxy in front before exposing remotely.
SEFORGE_BIND_ADDRESS=127.0.0.1
SEFORGE_HTTP_PORT=8080
SEFORGE_API_PROFILES=prod
SEFORGE_WORKER_PROFILES=prod,worker
SESSION_COOKIE_SECURE=true
SEFORGE_API_RATE_LIMIT_GENERAL=600
SEFORGE_API_RATE_LIMIT_EXPENSIVE=30
SEFORGE_API_RATE_LIMIT_UPLOAD=20

# Core data services
MYSQL_DATABASE=seforge
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
MYSQL_APP_USERNAME=seforge
MYSQL_APP_PASSWORD=change-me-mysql-app-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
REDIS_PASSWORD=change-me-redis-password

# Optional one-time administrator bootstrap for an empty database.
# Leave the password empty to disable bootstrap; when set it must be 10-72 characters.
SEFORGE_BOOTSTRAP_ADMIN_EMAIL=
SEFORGE_BOOTSTRAP_ADMIN_PASSWORD=
SEFORGE_BOOTSTRAP_ADMIN_USERNAME=admin
SEFORGE_BOOTSTRAP_ADMIN_DISPLAY_NAME="SEForge Administrator"

# Object storage. Root credentials are used only by MinIO and the bucket bootstrap job.
MINIO_ROOT_USER=change-me-minio-root-user
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_APP_ACCESS_KEY=seforge-app
MINIO_APP_SECRET_KEY=change-me-minio-app-secret
MINIO_APP_BUCKET=seforge
SEFORGE_STORAGE_COURSE_QUOTA_BYTES=2147483648
SEFORGE_STORAGE_ATTACHMENT_USER_QUOTA_BYTES=536870912
SEFORGE_STORAGE_ATTACHMENT_COURSE_QUOTA_BYTES=2147483648

# Vector storage
MILVUS_ENABLED=true
MILVUS_COLLECTION_PREFIX=seforge_chunks
SEFORGE_VECTOR_ACTIVE_VERSION=text-embedding-v2
SEFORGE_VECTOR_WRITE_VERSION=text-embedding-v2
SEFORGE_VECTOR_RECONCILIATION_INTERVAL=15m

# AI providers are optional. Keep AI disabled until at least one provider is configured.
SEFORGE_AI_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave blank to route worker traffic through the fixed allow-list proxy. A load-test
# stub may set these to an HTTP service that is attached to the internal data network.
SEFORGE_WORKER_DEEPSEEK_BASE_URL=
SEFORGE_WORKER_DASHSCOPE_BASE_URL=
SEFORGE_FAST_MODEL=deepseek-chat
SEFORGE_REASONING_MODEL=deepseek-reasoner
SEFORGE_CODING_MODEL=deepseek-chat
SEFORGE_FALLBACK_MODEL=qwen-plus
SEFORGE_EMBEDDING_MODEL=text-embedding-v2
SEFORGE_EMBEDDING_DIMENSION=1536
SEFORGE_AI_TIMEOUT=45s
SEFORGE_AI_MAX_RETRIES=3

# Optional SonarQube review profile (`docker compose --profile review ...`).
SEFORGE_SONAR_ENABLED=false
SEFORGE_SONAR_SERVER_URL=http://sonarqube:9000
SEFORGE_SONAR_TOKEN=
SEFORGE_SONAR_SCANNER_EXECUTABLE=sonar-scanner
SONAR_HTTP_PORT=9002
SONAR_POSTGRES_DB=sonarqube
SONAR_POSTGRES_USER=sonarqube
SONAR_POSTGRES_PASSWORD=change-me-sonar-postgres-password

# Optional disposable load-test profile. These accounts and course must already exist.
# Keep credentials blank unless invoking the `load-test` Compose profile.
SEFORGE_LOAD_TEST_BASE_URL=http://frontend:8080
SEFORGE_LOAD_TEST_HEALTH_PATH=/healthz
SEFORGE_LOAD_TEST_COURSE_ID=
SEFORGE_LOAD_TEST_IDENTIFIER=
SEFORGE_LOAD_TEST_PASSWORD=
SEFORGE_LOAD_TEST_USER_PREFIX=
SEFORGE_LOAD_TEST_USER_COUNT=200
SEFORGE_LOAD_TEST_TEACHER_IDENTIFIER=
SEFORGE_LOAD_TEST_TEACHER_PASSWORD=
SEFORGE_LOAD_TEST_IDLE_VUS=125
SEFORGE_LOAD_TEST_API_VUS=50
SEFORGE_LOAD_TEST_SSE_VUS=20
SEFORGE_LOAD_TEST_JOB_VUS=5
SEFORGE_LOAD_TEST_DURATION=2m
SEFORGE_LOAD_TEST_SSE_TIMEOUT=2m
SEFORGE_LOAD_TEST_SSE_MAX_DURATION=3m
SEFORGE_LOAD_TEST_JOB_TIMEOUT_SECONDS=120
SEFORGE_LOAD_TEST_REQUIRE_SSE_CITATION=true
SEFORGE_LOAD_TEST_EXPECT_SSE_TERMINAL=done
