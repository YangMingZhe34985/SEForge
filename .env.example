# ==========================================
# SmartSE 环境变量示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交真实凭据）
# 后端 Spring Boot 通过操作系统环境变量读取以下配置（${VAR:default} 形式），
# 可在 IDE 运行配置、shell 或容器 env_file 中注入。
# ==========================================

# ---------- LLM API Keys（必填） ----------
# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 阿里云 DashScope / 通义千问 API Key（https://dashscope.console.aliyun.com）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ---------- 数据库 / 中间件（本地默认值可直接开发） ----------
MYSQL_USERNAME=root
MYSQL_PASSWORD=your-mysql-password
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ---------- 头像存储（部署环境按需覆盖） ----------
AVATAR_BASE_DIR=/opt/app/resources/img/avatars/
AVATAR_ACCESS_URL_PREFIX=http://localhost:8080/avatar/

# ---------- 模型与临时目录（可选，缺省值如下） ----------
WHISPER_MODEL_PATH=./models/whisper
WHISPER_PYTHON_PATH=python
PYTHON_PATH=python
VIDEO_TEMP_DIR=./temp/video
PDF_TEMP_DIR=./temp/pdf
PDF_IMAGES_DIR=./temp/pdf/images
